<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Battle/ 纯公式层单测（根规范 §4 红线 1 的收益：公式可脱离引擎回归）。
    不引用 Godot 工程程序集，而是直接链编源文件：
      * TheGame/GameScripts/Battle/*.cs           —— 被测代码
      * GameProto/GameConfig/Battle/BattleConfig.cs 等 —— Luban 生成的战斗常数类（纯 C#，无 Godot 依赖）
      * Framework/.../Lib/LubanLib/*.cs           —— Luban 运行时（ByteBuf，反序列化 .bytes）
      * Framework/GameFramework/Base/ReferencePool —— AttackData 的池（GF 纯 C# 层）
    常数不手抄：测试运行时读取 DataTables/GameConfigs/battle_tbbattleconfig.bytes（与游戏同一份产物），
    所以表值改动会直接反映到断言上。

    运行：dotnet test Tests/BattleTests
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>GameLogic.Battle.Tests</RootNamespace>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..\Godot\GodotProject\</GodotProjectDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Battle\*.cs" Link="Linked\Battle\%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\Battle\BattleConfig.cs" Link="Linked\GameConfig\BattleConfig.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\Battle\TbBattleConfig.cs" Link="Linked\GameConfig\TbBattleConfig.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\Battle\DamageKind.cs" Link="Linked\GameConfig\DamageKind.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\Sound\SoundId.cs" Link="Linked\GameConfig\SoundId.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GodotGameFrameworkCore\Lib\LubanLib\*.cs" Link="Linked\Luban\%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\ReferencePool\*.cs" Link="Linked\ReferencePool\%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\GameFrameworkException.cs" Link="Linked\Framework\GameFrameworkException.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Utility\Utility.cs" Link="Linked\Framework\Utility.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Utility\Utility.Text.cs" Link="Linked\Framework\Utility.Text.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Utility\Utility.Text.ITextHelper.cs" Link="Linked\Framework\Utility.Text.ITextHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(GodotProjectDir)TheGame\DataTables\GameConfigs\battle_tbbattleconfig.bytes" Link="Data\battle_tbbattleconfig.bytes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
