<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- 链接的 Godot 脚本没有源码生成器，[Export] 字段按未赋值分析，抑制该噪音警告。 -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..\Godot\GodotProject\</GodotProjectDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Level\Camera\LevelCamera.cs" Link="Linked\LevelCamera.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Level\Stage\LevelStagePhase.cs" Link="Linked\LevelStagePhase.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Level\Stage\LevelStageSequence.cs" Link="Linked\LevelStageSequence.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Level\Spawning\LevelSpawnSchedule.cs" Link="Linked\LevelSpawnSchedule.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\Level\*.cs" Link="Linked\Config\%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\Entity\EntityId.cs" Link="Linked\Config\EntityId.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GodotGameFrameworkCore\Lib\LubanLib\*.cs" Link="Linked\Luban\%(Filename)%(Extension)" />
    <None Include="$(GodotProjectDir)TheGame\DataTables\GameConfigs\level_tblevelconfig.bytes" Link="Data\level_tblevelconfig.bytes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- 相机取景是节点上的纯静态算法：引用 GodotSharp 即可在纯控制台验证，不需要引擎进程。 -->
    <PackageReference Include="GodotSharp" Version="4.7.2" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
