<Project Sdk="Microsoft.NET.Sdk">

  <!--
    档案与存档领域层单测（纯 C#，不需要引擎进程）：
      * TheGame/GameScripts/Models/Profile/*.cs  —— 档案、成长、钱包、出战装配
      * TheGame/GameScripts/Models/Save/*.cs     —— 存档 DTO、当前格式与档案映射（SaveSystem 依赖 GF，排除）
      * TheGame/GameScripts/Systems/Combat/*.cs —— 出战装配写入的属性汇总
      * TheGame/GameScripts/Models/ConfigurationModel.cs / Systems/ConfigurationSystem.cs —— 共享配置与启动校验（读取真实表产物）
    常数与数值不手抄：测试运行时读取 DataTables/GameConfigs/*.bytes（与游戏同一份产物）。

    运行：dotnet test Tests/ProfileTests
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>GameLogic.Profile.Tests</RootNamespace>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..\Godot\GodotProject\</GodotProjectDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Level\ChapterRules.cs" />
    <Compile Include="*.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\MainPack\Scripts\Debug\ProfileTestData.cs" Link="ProfileTestData.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Arch\*.cs" Exclude="$(GodotProjectDir)TheGame\GameScripts\Arch\FsmArchitectureExtensions.cs;$(GodotProjectDir)TheGame\GameScripts\Arch\GgfArchitectureExtensions.cs" Link="Linked\Architecture\%(Filename)%(Extension)" />
    <!-- 访问契约与扩展保持纯 C#；GGF FSM 适配器由真实引擎烟测覆盖。 -->
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\Profile\EquipmentData.cs" Link="Linked\EquipmentData.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\Profile\EquipmentAttributes.cs" Link="Linked\EquipmentAttributes.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\EquipmentSystem.cs" Link="Linked\Systems\EquipmentSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Commands\EquipmentCommands.cs" Link="Linked\Commands\EquipmentCommands.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Queries\EquipmentSaleSummaryQuery.cs" Link="Linked\Queries\EquipmentSaleSummaryQuery.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Queries\LevelGuideQuery.cs" Link="Linked\Queries\LevelGuideQuery.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\Input\HeroActionData.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Heroes\Wukong\Skills\*.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Heroes\Skills\ISkillActor.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\Input\InputSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\SkillModel.cs" Link="Linked\Models\SkillModel.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\SkillSystem.cs" Link="Linked\Systems\SkillSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Commands\LearnSkillCommand.cs" Link="Linked\LearnSkillCommand.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Drops\LootReward.cs" Link="Linked\LootReward.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\LootSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Utilities\Utility\ExperienceCurveUtility.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Utilities\Utility\SaveDataUtility.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\Profile\ProfileModel.cs" Link="Linked\Models\Profile\ProfileModel.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\ProfileSystem.cs" Link="Linked\Systems\ProfileSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\Save\**\*.cs" Link="Linked\Save\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\HeroModel.cs" Link="Linked\Models\HeroModel.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\Hero\HeroSystem.cs" Link="Linked\Systems\Hero\HeroSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\Hero\HeroStatusSystem.cs" Link="Linked\Systems\Hero\HeroStatusSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\Combat\*.cs" Link="Linked\Combat\%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\ConfigurationModel.cs" Link="Linked\ConfigurationModel.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\ConfigurationSystem.cs" Link="Linked\ConfigurationSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Utilities\Utility\ConfigIdUtility.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\ExternalTypeUtil.cs" Link="Linked\ExternalTypeUtil.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Body\*.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Heroes\Body\**\*.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Fsm\*.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\ReferencePool\*.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\Variable\*.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\GameFrameworkException.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\GameFrameworkModule.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Base\DataStruct\TypeNamePair.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Utility\Utility.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Utility\Utility.Text.cs" />
    <Compile Include="$(GodotProjectDir)Framework\GameFramework\Utility\Utility.Text.ITextHelper.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Enemies\Body\Core\EnemyBodyParams.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\Level\LevelModel.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Systems\LevelSystem.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Models\Level\LevelResult.cs" />
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\Entity\Level\Stages\LevelStageSequence.cs" />
    <!-- 全量配置类型：Tables 聚合全部表，启动校验需要真实 Tables -->
    <Compile Include="$(GodotProjectDir)TheGame\GameScripts\GameProto\GameConfig\**\*.cs" Link="Linked\GameConfig\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(GodotProjectDir)Framework\GodotGameFrameworkCore\Lib\LubanLib\*.cs" Link="Linked\Luban\%(Filename)%(Extension)" />
    <!-- GameData/GameCatalogue 继承的框架基类由本目录 ArchiveDataStub.cs 提供（框架原文件依赖 Godot 资源加载） -->
  </ItemGroup>

  <ItemGroup>
    <None Include="$(GodotProjectDir)TheGame\DataTables\GameConfigs\*.bytes" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="GodotSharp" Version="4.7.2" />
    <!-- 与游戏工程同版本，验证当前存档 JSON 往返与格式拒绝 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
