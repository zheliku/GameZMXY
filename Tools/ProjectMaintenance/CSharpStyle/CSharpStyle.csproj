<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/Microsoft.CodeAnalysis.Workspaces.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
    <Reference Include="System.Composition.AttributedModel" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/System.Composition.AttributedModel.dll" />
    <Reference Include="System.Composition.Runtime" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/System.Composition.Runtime.dll" />
    <Reference Include="System.Composition.Hosting" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/System.Composition.Hosting.dll" />
    <Reference Include="System.Composition.TypedParts" HintPath="$(MSBuildSDKsPath)/../DotnetTools/dotnet-format/System.Composition.TypedParts.dll" />
