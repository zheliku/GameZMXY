; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GameZMXY"
run/main_scene="uid://bggentry001"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="uid://0qvr220neg1y"

[audio]

buses/default_bus_layout="uid://yynf8xejw6q4"

[autoload]

UpdateDriver="*uid://d1724h61rw1bg"
SmokeTestDriver="*res://TheGame/MainPack/Scripts/Debug/SmokeTestDriver.cs"

[display]

window/size/viewport_width=940
window/size/viewport_height=590
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="GodotProject"

[editor_plugins]

enabled=PackedStringArray("res://addons/ComponentInsoector/plugin.cfg", "res://addons/ExportInspector/plugin.cfg", "res://addons/TopMenu/plugin.cfg", "res://addons/asset_bundle/plugin.cfg", "res://addons/ezpz_inspector/plugin.cfg")

[file_customization]

folder_colors={
"res://Framework/GodotGameFrameworkCore/": "orange",
"res://TheGame/": "green",
"res://TheGame/GameScripts/GameProto/": "gray",
"res://TheGame/MainPack/": "blue"
}

